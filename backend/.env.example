# Copy this file to backend/.env and edit for the target machine.
#   copy .env.example .env

# Flask
PORT=5000
JWT_SECRET=change-this-on-each-machine

# PostgreSQL (CRUD / app DB)
POSTGRES_URL=postgresql+psycopg2://postgres:Hercules@localhost:5432/sap

# SQL Server (read-only SCADA) — unused in demo mode
MSSQL_URL=mssql+pyodbc://USER:PASSWORD@localhost/HerculesV2?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# SAP
SAP_BASE_URL=https://vhmioqs4ci.sap.mc3.com.sa:44300
SAP_MOCK_URL=http://localhost:6000/mock
SAP_USERNAME=99999
SAP_PASSWORD=your-sap-password
SAP_CLIENT=250
SAP_TIMEOUT=30
SAP_ENDPOINT=/zmi_get_orders/GETORD
