# Copy this file to backend/.env and edit for the target machine.
#   copy .env.example .env

# Flask
PORT=5000
JWT_SECRET=change-this-on-each-machine

# Comma-separated browser origins allowed to call the API (B5).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (CRUD / app DB) — required, no code fallback
POSTGRES_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/sap

# SQL Server (read-only SCADA)
# Set MSSQL_ENABLED=false on machines without ODBC/SQL Server (demo + mock SAP only)
MSSQL_ENABLED=false
MSSQL_URL=mssql+pyodbc://USER:PASSWORD@localhost/HerculesV2?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# Optional SCADA source table override (B5)
# SCADA_SOURCE_TABLE=[HerculesV2].[dbo].[ASMArchive_DB5]

# SAP
SAP_BASE_URL=https://vhmioqs4ci.sap.mc3.com.sa:44300
SAP_MOCK_URL=http://localhost:6000/mock
SAP_USERNAME=99999
SAP_PASSWORD=your-sap-password
SAP_CLIENT=250
SAP_TIMEOUT=30
SAP_ENDPOINT=/zmi_get_orders/GETORD
