# Copy to Frontend/.env for local Vite.
# Leave VITE_API_BASE_URL empty to use same-origin / relative /api URLs.

# Dev proxy target (npm run dev)
VITE_BACKEND_URL=http://localhost:5000

# Optional: absolute API host for production/ngrok (used by apiConfig.ts)
# VITE_API_BASE_URL=http://NEW_MACHINE_IP:5000
