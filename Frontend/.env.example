# Hercules SFMS Environment Configuration
# Copy this file to .env and update with your values

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/hercules_sfms

# PostgreSQL Connection Details (auto-populated from DATABASE_URL)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=username
# PGPASSWORD=password
# PGDATABASE=hercules_sfms

# Server Configuration
PORT=5000
NODE_ENV=production

# Application Settings
APP_NAME="Hercules SFMS"
APP_VERSION="2.0"

# Session Secret (generate a random string)
SESSION_SECRET=your-random-session-secret-here

# Logging Level
LOG_LEVEL=info

# CORS Settings (if needed for external access)
# CORS_ORIGIN=http://your-domain.com

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=./uploads

# PLC Communication Settings
# Note: PLC connection details are configured through the Admin interface
# Default polling interval in milliseconds
PLC_DEFAULT_POLL_INTERVAL=5000

# Database Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# Feature Flags
ENABLE_DEBUG_LOGS=false
ENABLE_PLC_SIMULATION=false

# Timezone (for accurate timestamps)
TZ=UTC

# Performance Settings
# Maximum number of historical records to display
MAX_HISTORY_RECORDS=10000

# Data Retention (days)
DATA_RETENTION_DAYS=90

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100